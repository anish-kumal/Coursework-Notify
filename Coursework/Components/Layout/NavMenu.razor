<div class="top-row ps-3 navbar navbar-dark">
    <div style="display: flex; align-items: center;">
        <img src="images/logo.png" alt="Logo" style="height: 40px; width: auto; margin-right: 10px;">
        <span style="font-weight: bold; color: white; font-size: 20px;">Notify</span>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="home" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="journal">
                <span class="bi bi-journal-text-nav-menu" aria-hidden="true"></span> Journal
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/calendar">
                <span class="bi bi-calendar-event-nav-menu" aria-hidden="true"></span> Calendar
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="tags">
                <span class="bi bi-tag-fill-nav-menu" aria-hidden="true"></span> Tags
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="moods">
                <span class="bi bi-emoji-smile-fill-nav-menu" aria-hidden="true"></span> Moods
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <button class="nav-link" @onclick="Logout" style="cursor: pointer;">
                <span class="bi bi-box-arrow-right-nav-menu" aria-hidden="true"></span> Log Out
            </button>
        </div>
    </nav>
</div>

@code {
    [Inject] NavigationManager Navigation { get; set; } = default!;

    private void Logout()
    {
        Navigation.NavigateTo("/");
    }
}
